/* ============ 法务退回：填写审查意见 + 保留退回痕迹 ============ */
/* 常用理由：右击可编辑重命名，按理由内容自动截取显示，localStorage 持久化 */
const REASON_KEY = 'qb_common_reasons';
const DEFAULT_REASONS = [
  '保密期限条款超出公司标准，请修改后重新提交',
  '关键条款（金额/交付）缺失或不明确，请补充',
  '对方主体信息与营业执照不一致，请核实'
];
function commonReasons() {
  try { const v = JSON.parse(localStorage.getItem(REASON_KEY)); if (Array.isArray(v) && v.length) return v; } catch (e) {}
  return DEFAULT_REASONS.slice();
}
function saveCommonReasons(arr) { try { localStorage.setItem(REASON_KEY, JSON.stringify(arr)); } catch (e) {} }
function truncTxt(s, n) { s = String(s || '').replace(/\s+/g, ' ').trim(); return s.length > n ? s.slice(0, n) + '…' : s; }

function renderReasonChips(layer, ta) {
