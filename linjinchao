  partyB: '乙方公司主体', partyBAddress: '乙方地址', contact: '乙方联系人', phone: '联系电话',
  service: '采购内容', amount: '合同金额', taxRate: '含税说明', deliveryDays: '交付期限', deliveryMethod: '交付方式', settleMethod: '结算方式',
  invoiceInfo: '甲方开票信息', payInfo: '乙方收款信息', projectName: '项目名称'
