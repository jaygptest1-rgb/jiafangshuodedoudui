let sealUid = 0;
function starPath(cx, cy, r) {
  const pts = [];
  for (let i = 0; i < 10; i++) {
    const rad = i % 2 === 0 ? r : r * 0.42;
    const ang = -Math.PI / 2 + i * Math.PI / 5;
    pts.push(`${(cx + rad * Math.cos(ang)).toFixed(2)},${(cy + rad * Math.sin(ang)).toFixed(2)}`);
  }
  return `M ${pts.join(' L ')} Z`;
}
function sealSVG(companyName, ghost) {
  const name = (companyName || '公司名称').slice(0, 13);
  const fs = name.length > 10 ? 6.6 : (name.length > 8 ? 7.4 : 8.2);
  const uid = 'arc' + (++sealUid);
  const op = ghost ? '0.4' : '1';
  return `<svg class="seal-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="opacity:${op}">
    <circle cx="50" cy="50" r="46" fill="none" stroke="#c8102e" stroke-width="2.8"/>
    <circle cx="50" cy="50" r="41.5" fill="none" stroke="#c8102e" stroke-width="0.7" opacity=".6"/>
    <defs><path id="${uid}" d="M 17,55 A 33,33 0 1,1 83,55" fill="none"/></defs>
    <text fill="#c8102e" font-size="${fs}" font-weight="700" letter-spacing="0.3"
          font-family="PingFang SC, Microsoft YaHei, sans-serif">
      <textPath href="#${uid}" startOffset="50%" text-anchor="middle">${escXml(name)}</textPath>
    </text>
    <path d="${starPath(50, 52, 11.5)}" fill="#c8102e"/>
    <text x="50" y="79" fill="#c8102e" font-size="7.4" text-anchor="middle" font-weight="700"
          font-family="PingFang SC, Microsoft YaHei, sans-serif">合同专用章</text>
  </svg>`;
}

