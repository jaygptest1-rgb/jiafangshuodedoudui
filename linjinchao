  '樓':'楼','廈':'厦','橋':'桥','裡':'里','內':'内','兩':'两','為':'为','從':'从','這':'这','關':'关','鍵':'键',
  '產':'产','長':'长','場':'场','員':'员','負':'负','責':'责','實':'实','驗':'验','證':'证','書':'书','圖':'图',
  '紙':'纸','製':'制','機':'机','設':'设','備':'备','維':'维','護':'护','報':'报','銷':'销','購':'购','買':'买',
  '賣':'卖','錢':'钱','銀':'银','賬':'账','戶':'户','賓':'宾','館':'馆','飯':'饭','廳':'厅','棟':'栋','萬':'万',
  '億':'亿','團':'团','際':'际','彙':'汇','總':'总','結':'结','餘':'余','頓':'顿','時':'时','間':'间','週':'周',
  '歲':'岁','齡':'龄','認':'认','識':'识','別':'别','選':'选','擇':'择','確':'确','認':'认','資':'资','訊':'讯'
};
function toSimplified(s) { return String(s || '').replace(/[\u3400-\u9fff]/g, ch => T2S_MAP[ch] || ch); }
function fullToHalf(s) {
  return String(s || '').replace(/[\uff01-\uff5e]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xfee0))
    .replace(/\u3000/g, ' ');
}

function parsePartyBBlock(raw) {
  const text = toSimplified(fullToHalf(raw)).replace(/\r/g, '');
  const lines = text.split(/\n+|；|;/).map(l => l.replace(/^[\s,，、:：·|｜-]+/, '').trim()).filter(Boolean);
  const res = { partyB: '', partyBAddress: '', contact: '', phone: '' };

  // 电话：优先 11 位手机，其次座机（+86 前缀、横线/空格分隔均兼容）
  const cleaned = text.replace(/[-\s]/g, '');
  const mob = cleaned.match(/(?:\+?86)?1[3-9]\d{9}/);
  const tel = cleaned.match(/0\d{2,3}\d{7,8}/);
  if (mob) res.phone = mob[0].replace(/^\+?86/, '');
  else if (tel) res.phone = tel[0].replace(/[\s-]/g, '');

  for (const line of lines) {
    const ll = line.toLowerCase();
    const isAddrLabel = /^(地址|通讯地址|办公地址|address|add\b)/.test(ll);
    const isContactLabel = /^(联系人|联络人|联系人姓名|contact( person| name)?|attn)/.test(ll);
    const isCompanyLike = /(公司|集团|有限|股份|商行|事务所|中心|研究院|ltd|limited|inc|corp|llc|company|co\.|gmbh)/.test(ll);
    const isMetaLine = /(联系人|contact|电话|phone|tel|手机|mobile|地址|address|传真|fax|邮箱|email|e-mail)/.test(ll);

    // 公司名：包含公司关键词且不是地址/联系人/电话行
    if (!res.partyB && isCompanyLike && !isAddrLabel && !isContactLabel && !/(电话|phone|tel|手机|mobile)/.test(ll)) {
      res.partyB = line.replace(/^(乙方|供方|供应商|卖方|seller|party\s*b)\s*[:：]\s*/i, '').trim();
      continue;
    }
    // 地址
    if (!res.partyBAddress && (isAddrLabel || (!isCompanyLike && !isMetaLine && !isContactLabel && /(路|街|道|大道|大厦|广场|号楼|栋|室|座|floor|room|road|district|区|县|市)/.test(line) && line.length >= 6))) {
      res.partyBAddress = line.replace(/^(地址|通讯地址|办公地址|address|add)\s*[:：]?\s*/i, '').trim();
      continue;
    }
    // 联系人
    if (!res.contact) {
      if (isContactLabel) {
        res.contact = line.replace(/^(联系人|联络人|contact( person| name)?|attn)\s*[:：]?\s*/i, '')
          .replace(/(电话|phone|tel|手机|mobile|邮箱|email)\s*[:：]?\S*$/i, '').trim();
      } else if (/(先生|女士|小姐|先生|Ms\.|Mr\.|Miss)/.test(line)) {
        const m = line.match(/([\u4e00-\u9fa5]{1,3}(?:先生|女士|小姐)|[A-Z][a-z]+\s[A-Z][a-z]+|(?:Mr\.|Ms\.|Miss)\s?\S+)/);
        if (m) res.contact = m[1];
      }
    }
  }
  return res;
}


