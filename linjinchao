  return `<div class="page-head"><h1>发起签约</h1><p>合同编号 ${escHtml(c.no)}</p></div>
  <div class="fill-layout">
    <div class="fill-left">
      <div class="preview-bar"><span>合同预览</span><span class="s ${st.cls}">${st.text}</span></div>
      ${renderContractPreview(c, false)}
    </div>
    <div class="fill-right">
      <div class="fill-panels">
        <div class="panel">
