   数据过滤
   ======================================================= */
function visibleContracts() {
  if (state.role === 'legal') return state.contracts;
  return state.contracts.filter(c => c.createdBy === currentUser().name);
}

function displayDate(c) {
  return (c.aSignedAt || c.createdAt || '').split(' ')[0];
}

function matchDateRange(dateStr, range) {
  if (range === 'all') return true;
  if (!dateStr) return false;
  const d = new Date(dateStr + 'T00:00:00'), now = new Date(), today0 = new Date(now.getFullYear(), now.getMonth(), now.getDate()), dayMs = 86400000;
  switch (range) {
    case 'today': return d.getTime() === today0.getTime();
    case '7d': return (today0 - d) / dayMs <= 7 && d <= today0;
    case '30d': return (today0 - d) / dayMs <= 30 && d <= today0;
    default: return true;
  }
}

function getFilteredContracts() {
  const f = state.filters;
  return visibleContracts().filter(c => {
    if (f.partyA && c.partyAId !== f.partyA) return false;
    if (f.partyB && !String(c.partyB || '').toLowerCase().includes(f.partyB.toLowerCase())) return false;
    if (f.dateRange !== 'all' && !matchDateRange(displayDate(c), f.dateRange)) return false;
    if (f.status !== 'all' && c.status !== f.status) return false;
    return true;
  });
}

