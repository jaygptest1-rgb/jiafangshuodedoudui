/* 将本页面自身下载为本地 HTML 文件（数据均在页面内，保存后功能完整） */
function downloadPage() {
  const fallback = () => toast('自动下载失败，请按 Ctrl+S（Mac：Cmd+S）另存本页');
  const save = (text) => {
    try {
      const blob = new Blob([text], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = '七只小牛签约系统.html';
      document.body.appendChild(a); a.click(); a.remove();
      toast('已开始下载，请查看浏览器下载列表');
    } catch (e) { fallback(); }
  };
  if (/^https?:/.test(location.protocol)) {
    fetch(location.href, { cache: 'no-store' }).then(r => r.text()).then(save).catch(fallback);
  } else {
    save('<!DOCTYPE html>\n' + document.documentElement.outerHTML);
  }
}
function toast(msg) {
  const t = document.createElement('div');
  t.className = 'toast';
  t.textContent = msg;
  document.body.appendChild(t);
  requestAnimationFrame(() => t.classList.add('show'));
  setTimeout(() => {
    t.classList.remove('show');
    setTimeout(() => t.remove(), 300);
  }, 2600);
}
function showConfirm(title, msg, okText, onOk) {
  const layer = document.createElement('div');
  layer.className = 'modal-mask';
  layer.innerHTML = `<div class="modal-sm">
    <h3>${escHtml(title)}</h3>
