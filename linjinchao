/* 整段粘贴识别填充（类似外卖APP地址识别）：以回车为识别信号 */
function applyPartyBBlock() {
  const box = document.getElementById('partyBPasteBox');
  const raw = box ? box.value : '';
  if (!raw.trim()) return toast('请先粘贴乙方信息文本');
  const r = parsePartyBBlock(raw);
  if (!r.partyB && !r.phone && !r.contact && !r.partyBAddress) {
    state.form.partyBSmartFail = true; state.form.partyBSmartTip = ''; render();
    return toast('未能从文本中识别出乙方信息，请检查格式');
  }
  if (r.partyB) state.form.partyB = r.partyB;
  if (r.partyBAddress) state.form.partyBAddress = r.partyBAddress;
  if (r.contact) state.form.contact = r.contact;
  if (r.phone) state.form.phone = r.phone.replace(/\D/g, '').slice(0, 11);
  // 公司库二次校验补全缺失字段（识别文本可能是英文名/繁体）
  const m = matchPartyB(r.partyB || '');
  if (m) {
    if (!r.partyBAddress) state.form.partyBAddress = m.address;
    if (!r.contact) state.form.contact = m.contact;
    if (!r.phone) state.form.phone = m.phone;
    if (!r.partyB) state.form.partyB = m.name;
    state.form.partyB = m.name;
  }
  state.form.partyBSmartTip = [r.partyB, r.partyBAddress, r.contact, r.phone].filter(Boolean).length >= 3
    ? '整段识别成功' : '部分识别成功';
  state.form.partyBSmartFail = false;
  render();
  toast('已按粘贴内容智能填充乙方信息');
}

function smartFillPartyB() {
  const raw = String(state.form.partyB || '').trim();
  if (!raw) { toast('请先输入乙方公司名称'); const inp = document.getElementById('partyBInput'); if (inp) inp.focus(); return; }
  const m = matchPartyB(raw);
  if (!m) {
    state.form.partyBSmartTip = ''; state.form.partyBSmartFail = true;
    render();
    toast('未匹配到公司库，请手动填写乙方信息');
