/* ============ 乙方信息整段粘贴智能识别（中英文/繁体混排） ============ */
const T2S_MAP = {
  '臺':'台','灣':'湾','區':'区','園':'园','門':'门','東':'东','車':'车','馬':'马','鳥':'鸟','龍':'龙','鳳':'凤',
  '廣':'广','業':'业','網':'网','絡':'络','數':'数','據':'据','雲':'云','聯':'联','係':'系','於':'于','與':'与',
  '會':'会','務':'务','經':'经','營':'营','運':'运','輸':'输','倉':'仓','儲':'储','遞':'递','應':'应','層':'层',
  '後':'后','發':'发','達':'达','華':'华','國':'国','際':'际','貿':'贸','協':'协','議':'议','標':'标','簽':'签',
