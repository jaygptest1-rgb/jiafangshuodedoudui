  const originTpl = state.tpls.find(t => t.code === c.originTplCode);
  let leftContent = '';
  
  if (state.approvalTab === 'origin') {
    leftContent = originTpl 
      ? `<div class="doc">${renderDoc({ ...originTpl, tplName: originTpl.name }, false)}</div>` 
      : `<div class="empty">未找到原模板</div>`;
  } else if (state.approvalTab === 'upload') {
    leftContent = `<div class="doc" style="padding:24px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div class="h" style="font-size:16px;margin:0;">业务上传文档全文</div>
        <button class="btn btn-sm" data-act="download-upload" data-id="${c.id}">下载文档</button>
      </div>
      <div style="background:var(--surface-2);padding:16px;border-radius:6px;font-size:13px;line-height:1.8;white-space:pre-wrap;">${escHtml(c.parsedText || '未提取到文本内容')}</div>
