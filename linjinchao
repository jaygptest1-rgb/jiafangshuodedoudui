function docCtx(c) {
  const f = c.fields || {};
  return Object.assign({}, f, {
    contractNo: c.no, partyA: c.partyAName, partyB: c.partyB, contact: c.contact, phone: c.phone,
    partyAAddress: c.partyAAddress, partyAContact: c.partyAContact, partyAPhone: c.partyAPhone, partyBAddress: c.partyBAddress,
    amountUpper: f.amount ? toChineseAmount(Number(f.amount)) : ''
  });
}

function inlineLine(rawLine, ctx, preview) {
  let line = escHtml(rawLine);
  line = line.replace(/\{\{(\w+)\}\}/g, (m, k) => {
    if (k === 'amount' || k === 'amountUpper') {
      const v = ctx[k];
      return v ? `<strong>${escHtml(v)}</strong>` : (preview ? '<span class="blank">［合同金额］</span>' : '');
    }
    const v = ctx[k];
    if (v === undefined || v === null || v === '') {
      return preview ? `<span class="blank">［${escHtml(LABEL_MAP[k] || k)}］</span>` : '';
    }
    return escHtml(v);
  });
  line = line.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  return line;
}

function signAreaHtml(c, preview) {
  let sealA = '';
  if (c.aSealed) sealA = sealSVG(c.partyAName);
  else if (preview && c.partyAName) sealA = sealSVG(c.partyAName, true);
  const sealB = c.bSealed ? sealSVG(c.partyB) : '';
  return `<div class="sign-area">
    <div class="sign-block">
      <p>甲方（盖章）：</p>
      <div class="seal-slot">${sealA}</div>
      <p>日期：${escHtml(c.aSignedAt || '')}</p>
    </div>
    <div class="sign-block">
      <p>乙方（盖章）：</p>
      <div class="seal-slot">${sealB}</div>
      <p>日期：${escHtml(c.bSignedAt || '')}</p>
    </div>
  </div>`;
}

function renderDoc(c, preview) {
  const ctx = docCtx(c);
  const bodyHtml = String(c.body || '').split('\n').map(line => {
    const t = line.trim();
    if (!t) return '';
    if (t.startsWith('##')) return `<p class="h">${escHtml(t.slice(2).trim())}</p>`;
    return `<p>${inlineLine(t, ctx, preview)}</p>`;
  }).join('');

  return `<div class="doc-title">${escHtml(c.tplName || '合同')}</div>
    <p class="doc-no">合同编号：${escHtml(c.no || '')}　·　模板编号：${escHtml(c.tplCode || '')}</p>
    ${bodyHtml}
    ${signAreaHtml(c, preview)}`;
}

function renderContractPreview(c, preview) {
