          <div class="info-row"><span class="k">乙方主体</span><span class="v">${escHtml(c.partyB)}</span></div>
          <div class="info-row"><span class="k">乙方联系人</span><span class="v">${escHtml(c.contact || '—')}</span></div>
          <div class="info-row"><span class="k">联系电话</span><span class="v">${escHtml(c.phone || '—')}</span></div>
          <div class="info-row"><span class="k">合同类型</span><span class="v">${escHtml(c.contractType || '—')}</span></div>
          ${c.returnCount ? `<div class="info-row"><span class="k">累计退回</span><span class="v" style="color:var(--danger);font-weight:600;">第 ${c.returnCount} 轮</span></div>` : ''}
        </div>
