  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>合同编号</th><th>合同名称</th><th>提交人</th><th>对方主体</th><th>提交时间</th><th>操作</th></tr></thead>
    <tbody>
      ${list.map(c => `
        <tr>
