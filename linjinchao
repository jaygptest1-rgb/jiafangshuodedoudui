<html lang="zh-CN"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>七只小牛签约系统</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #f2f5f9;
  --surface: #ffffff;
  --surface-2: #f7f9fc;
  --surface-3: #e8eef6;
  --border: #e2e8f0;
  --border-2: #dcdfe6;
  --text: #1d2129;
  --text-2: #4e5969;
  --text-3: #86909c;
  --brand: #165dff;
  --brand-2: #0e42d2;
  --brand-soft: #e8f3ff;
  --danger: #f53f3f;
  --success: #00b42a;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  font-size: 14px; line-height: 1.5;
  color: var(--text); background: var(--bg);
  height: 100vh; overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ========== 顶栏 ========== */
.topbar {
  height: 56px; background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 24px; flex-shrink: 0; z-index: 20; position: relative;
}
.logo { display: flex; align-items: center; gap: 10px; }
.logo-mark {
  width: 26px; height: 26px; border-radius: 6px;
  background: linear-gradient(135deg, #165dff, #4080ff);
  display: grid; place-items: center;
  color: #fff; font-size: 13px; font-weight: 700;
  box-shadow: 0 2px 8px rgba(22,93,255,.3);
}
.logo-text { font-size: 15px; font-weight: 600; color: var(--text); letter-spacing: .3px; }
.top-right { display: flex; align-items: center; gap: 16px; }
.role-switch { display: flex; background: var(--surface-2); border-radius: 5px; padding: 2px; border: 1px solid var(--border); }
.role-btn {
  border: none; background: transparent; padding: 5px 14px; border-radius: 4px;
  font-size: 12.5px; color: var(--text-2); cursor: pointer; font-family: inherit;
  transition: all .15s; font-weight: 500;
}
.role-btn.active { background: var(--surface); color: var(--brand); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.top-user { font-size: 13px; color: var(--text-2); }

/* ========== 布局 ========== */
.app-body { flex: 1; display: flex; overflow: hidden; height: calc(100vh - 56px); }
.sidebar {
  width: 216px; background: var(--surface);
  border-right: 1px solid var(--border);
  padding: 12px; flex-shrink: 0; display: flex; flex-direction: column;
}
.nav-group { margin-bottom: 2px; }
.nav-group-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 9px 12px; border-radius: 5px; cursor: pointer;
  font-size: 14px; font-weight: 500; color: var(--text);
  transition: background .15s; user-select: none;
}
.nav-group-head:hover { background: var(--surface-2); }
.nav-group-head.open .nav-arrow { transform: rotate(180deg); }
.nav-arrow { font-size: 10px; color: var(--text-3); transition: transform .2s; }
.nav-sub { overflow: hidden; max-height: 0; transition: max-height .25s ease; }
.nav-sub.open { max-height: 120px; }
.nav-item {
  padding: 8px 12px 8px 24px; border-radius: 5px;
  font-size: 13.5px; color: var(--text-2); cursor: pointer;
  transition: all .15s; margin-top: 1px;
}
.nav-item:hover { background: var(--surface-2); color: var(--text); }
.nav-item.active { background: var(--brand-soft); color: var(--brand); font-weight: 500; }
.nav-top {
  padding: 9px 12px; border-radius: 5px; font-size: 14px; font-weight: 500;
  color: var(--text); cursor: pointer; transition: all .15s; margin-top: 2px;
  display: flex; justify-content: space-between; align-items: center;
}
.nav-top:hover { background: var(--surface-2); }
.nav-top.active { background: var(--brand-soft); color: var(--brand); }
.nav-badge {
  font-size: 11px; background: var(--danger); color: #fff;
  padding: 0 6px; border-radius: 10px; font-weight: normal;
}
.sidebar-foot { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--border); }

/* ========== 主区域 ========== */
.main { flex: 1; overflow-y: auto; padding: 24px 28px; min-width: 0; }
.main.flex-main { overflow: hidden; display: flex; flex-direction: column; }
.page-head { margin-bottom: 20px; flex-shrink: 0; }
.page-head h1 {
  font-size: 20px; font-weight: 600; color: var(--text);
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.page-head p { font-size: 13px; color: var(--text-3); margin-top: 6px; }

/* ========== 按钮 ========== */
.btn {
  border: 1px solid var(--border-2); background: var(--surface); color: var(--text);
  padding: 6px 14px; border-radius: 4px; font-size: 13px; font-weight: 500;
  cursor: pointer; transition: all .15s; font-family: inherit;
  display: inline-flex; align-items: center; justify-content: center; gap: 4px;
  white-space: nowrap;
}
.btn:hover:not(:disabled) { background: var(--surface-2); border-color: #c9cdd4; color: var(--brand); }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn-primary {
  background: var(--brand); border-color: var(--brand); color: #fff;
  box-shadow: 0 2px 8px rgba(22,93,255,.25);
}
.btn-primary:hover:not(:disabled) { background: var(--brand-2); border-color: var(--brand-2); color: #fff; }
.btn-success { background: var(--success); border-color: var(--success); color: #fff; }
.btn-success:hover:not(:disabled) { background: #009a29; border-color: #009a29; color: #fff; }
.btn-danger { color: var(--danger); border-color: #ffcfc9; }
.btn-danger:hover:not(:disabled) { background: #fff2f0; border-color: #f53f3f; }
.btn-sm { padding: 4px 10px; font-size: 12px; }
.btn-lg { padding: 10px 28px; font-size: 14px; }

/* ========== 选项卡片 ========== */
.choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 780px; }
.choice-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 30px 26px; cursor: pointer; transition: all .18s;
}
.choice-card:hover { border-color: #94bfff; box-shadow: 0 4px 20px rgba(22,93,255,.08); transform: translateY(-1px); }
.choice-title { font-size: 16px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 8px; }
.choice-desc { font-size: 13px; color: var(--text-2); margin-top: 8px; line-height: 1.7; }
.choice-tag {
  font-size: 11px; font-weight: 500; padding: 1px 7px; border-radius: 3px;
  background: var(--brand-soft); color: var(--brand);
}
.choice-tag.orange { background: #fff7e8; color: #d25f00; }

/* ========== 模板/审批列表 ========== */
.tpl-list { display: flex; flex-direction: column; gap: 10px; }
.tpl-row {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 16px 20px; display: flex; align-items: center; gap: 14px;
  transition: all .15s;
}
.tpl-row:hover { border-color: #c9cdd4; box-shadow: 0 2px 10px rgba(0,0,0,.04); }
.tpl-code {
  font-family: ui-monospace, Menlo, monospace; font-size: 11.5px;
  color: var(--brand); background: var(--brand-soft);
  padding: 2px 8px; border-radius: 3px; white-space: nowrap;
}
.tpl-main { flex: 1; min-width: 0; }
.tpl-name { font-size: 14px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.tpl-desc { font-size: 12.5px; color: var(--text-3); margin-top: 4px; line-height: 1.5; }
.tpl-meta { font-size: 12px; color: var(--text-3); white-space: nowrap; }

/* ========== 填写页/审批页布局 ========== */
.fill-layout { flex: 1; min-height: 0; display: flex; gap: 18px; }
.fill-left { flex: 1; min-width: 0; overflow-y: auto; padding-right: 6px; }
.fill-right { width: 400px; flex-shrink: 0; display: flex; flex-direction: column; min-height: 0; }
.fill-right.wide { width: 460px; }
.fill-panels { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding-right: 4px; }
.panel { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; }
.panel-title {
  font-size: 13.5px; font-weight: 600; color: var(--text); margin-bottom: 14px;
  padding-bottom: 10px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 6px;
}
.panel-title::before {
  content: ''; width: 3px; height: 12px; border-radius: 1px; background: var(--brand);
}
.field { display: block; margin-bottom: 12px; }
.field:last-child { margin-bottom: 0; }
.field-label { display: block; font-size: 12.5px; font-weight: 500; color: var(--text-2); margin-bottom: 5px; }
.field-label i { color: var(--danger); font-style: normal; margin-left: 2px; }
.field input, .field select {
  width: 100%; padding: 7px 10px; border: 1px solid var(--border-2); border-radius: 4px;
  font-size: 13px; outline: none; transition: all .15s; background: var(--surface);
  font-family: inherit; color: var(--text);
}
.field input::placeholder { color: #c9cdd4; }
.field input:focus, .field select:focus { border-color: var(--brand); box-shadow: 0 0 0 2px rgba(22,93,255,.1); }
.field input.err, .field select.err { border-color: var(--danger); background: #fff2f0; animation: shake .35s; }
@keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
.fill-footer {
  display: flex; justify-content: flex-end; gap: 10px;
  padding-top: 14px; margin-top: 12px; border-top: 1px solid var(--border); flex-shrink: 0;
}

/* ========== 步骤条 ========== */
.step-indicator {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  background: var(--surface);
  padding: 16px 24px;
  border-radius: 8px;
  border: 1px solid var(--border);
}
.step-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-3);
  font-size: 13.5px;
  font-weight: 500;
}
.step-item.active {
  color: var(--brand);
}
.step-item.done {
  color: var(--success);
}
.step-num {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 600;
}
.step-item.active .step-num {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}
.step-item.done .step-num {
  background: var(--success);
  color: #fff;
  border-color: var(--success);
}
.step-line {
  flex: 1;
  height: 1px;
  background: var(--border);
}

/* ========== 智能识别与对比 ========== */
.smart-parse-box {
  background: #f2f9ff;
  border: 1px dashed #94bfff;
  border-radius: 6px;
  padding: 12px;
  margin-bottom: 14px;
}
.smart-parse-box textarea {
  width: 100%;
  height: 80px;
  padding: 8px;
  border: 1px solid var(--border-2);
  border-radius: 4px;
  font-size: 12.5px;
  resize: none;
  margin-bottom: 8px;
  font-family: inherit;
  outline: none;
}
.smart-parse-box textarea:focus { border-color: var(--brand); }
.smart-parse-box .btn { width: 100%; }

/* 自动识别结果卡片 */
.auto-card {
  background: linear-gradient(135deg, #f2f9ff, #e8f3ff);
  border: 1px solid #bedaff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
}
.auto-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.auto-card-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--brand);
}
.auto-badge {
  font-size: 11px;
  color: var(--brand);
  background: #fff;
  padding: 2px 8px;
  border-radius: 3px;
  border: 1px solid #bedaff;
}
.auto-extract-item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px dashed #bedaff;
  font-size: 13px;
}
.auto-extract-item:last-child { border-bottom: none; }
.auto-extract-item .k { color: var(--text-3); flex-shrink: 0; }
.auto-extract-item .v { color: var(--text); font-weight: 500; text-align: right; word-break: break-all; }

/* ========== 合同文档预览 ========== */
.doc {
  background: #fff; border-radius: 4px; padding: 38px 46px;
  font-family: "Songti SC", "SimSun", Georgia, serif;
  font-size: 13.5px; line-height: 2; color: #1a1d24;
  border: 1px solid var(--border);
  box-shadow: 0 2px 12px rgba(0,0,0,.04);
}
.doc-title { text-align: center; font-size: 20px; font-weight: 700; letter-spacing: 4px; margin-bottom: 14px; color: #0f1218; }
.doc-no { text-align: right; font-size: 12px; color: #8a919e; margin-bottom: 10px; font-family: ui-monospace, Menlo, monospace; }
.doc p { margin-bottom: 6px; }
.doc .h { font-weight: 700; margin-top: 14px; color: #0f1218; }
.doc strong { font-weight: 700; }
.doc del { color: #f53f3f; background: #fff2f0; text-decoration: line-through; padding: 0 2px; }
.doc ins { color: #00b42a; background: #e8ffea; text-decoration: none; padding: 0 2px; }
.blank { background: #fff7e8; color: #d25f00; padding: 0 4px; border-radius: 2px; font-size: 12px; }
.sign-area { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 32px; }
.sign-block p { margin-bottom: 4px; }
.seal-slot { min-height: 96px; display: flex; align-items: center; }
.seal-slot .seal-svg { width: 90px; height: 90px; }
.preview-bar {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 12.5px; color: var(--text-3); margin-bottom: 8px; padding: 0 2px;
  position: sticky; top: 0; background: var(--bg); z-index: 2; padding-bottom: 6px;
}

/* ========== 文件上传与预览 ========== */
.pdf-preview-wrap {
  width: 100%;
  background: #fff;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: 0 2px 12px rgba(0,0,0,.04);
  height: calc(100vh - 220px);
  min-height: 500px;
}
.pdf-iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}
.file-upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: calc(100vh - 300px);
  min-height: 400px;
  background: var(--surface);
  border: 2px dashed var(--border-2);
  border-radius: 8px;
  color: var(--text-3);
  padding: 24px;
  text-align: center;
  transition: all .2s;
  cursor: pointer;
}
.file-upload-hint.dragover {
  border-color: var(--brand);
  background: #f2f9ff;
}
.file-upload-hint .file-icon { font-size: 52px; margin-bottom: 16px; opacity: .6; }
.file-upload-hint h3 { font-size: 16px; color: var(--text-2); margin-bottom: 8px; font-weight: 500; }
.file-upload-hint p { font-size: 13px; line-height: 1.7; max-width: 360px; }
.file-info-box {
  margin-top: 10px;
  padding: 10px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 5px;
  font-size: 12.5px;
  color: var(--text-2);
  line-height: 1.6;
  word-break: break-all;
}
.file-info-box b { color: var(--text); }
.file-info-box.empty { color: var(--text-3); }

/* ========== 对比视图 ========== */
.diff-block {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 12px;
  font-size: 12.5px;
  line-height: 1.8;
  margin-bottom: 10px;
}
.diff-block .diff-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 6px;
}
.diff-block del { color: #f53f3f; background: #fff2f0; text-decoration: line-through; padding: 0 2px; }
.diff-block ins { color: #00b42a; background: #e8ffea; text-decoration: none; padding: 0 2px; }

/* ========== Tab 切换 ========== */
.tabs {
  display: flex;
  gap: 16px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 12px;
}
.tab-item {
  padding: 8px 4px;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--text-2);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}
.tab-item.active {
  color: var(--brand);
  border-bottom-color: var(--brand);
}

/* ========== 筛选条 ========== */
.filter-bar {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 12px 16px; display: flex; gap: 16px; align-items: center;
  margin-bottom: 12px; flex-wrap: wrap;
}
.filter-item { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-2); }
.filter-item label { white-space: nowrap; }
.filter-item select, .filter-item input {
  padding: 5px 10px; border: 1px solid var(--border-2); border-radius: 4px;
  font-size: 12.5px; font-family: inherit; color: var(--text); background: var(--surface);
  outline: none; transition: border-color .15s;
}
.filter-item select:focus, .filter-item input:focus { border-color: var(--brand); }
.filter-item input { width: 140px; }
.filter-item input::placeholder { color: #c9cdd4; }

/* ========== 表格 ========== */
.table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: auto; box-shadow: 0 2px 10px rgba(0,0,0,.02); }
.tbl { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 1180px; }
.tbl th {
  text-align: left; padding: 12px 14px; background: var(--surface-2); color: var(--text-2);
  font-weight: 500; border-bottom: 1px solid var(--border); font-size: 12.5px; white-space: nowrap;
}
.tbl td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
.tbl tr:last-child td { border-bottom: none; }
.tbl tbody tr:hover { background: var(--surface-2); }
.tbl .cno { font-family: ui-monospace, Menlo, monospace; font-size: 12px; color: var(--text-2); }
.tbl .tcode {
  font-family: ui-monospace, Menlo, monospace; font-size: 11.5px;
  color: var(--brand); background: var(--brand-soft);
  padding: 2px 7px; border-radius: 3px; white-space: nowrap; display: inline-block;
}
.tbl .strong { font-weight: 500; color: var(--text); }
.tbl .sub { font-size: 11.5px; color: var(--text-3); margin-top: 2px; }
.op-cell { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }

/* ========== 状态徽章 ========== */
.s {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 12px; font-weight: 500; padding: 2px 9px; border-radius: 3px; white-space: nowrap;
}
.s::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.s-review    { background: #f5e8ff; color: #722ed1; }
.s-returned  { background: #fff2f0; color: #f53f3f; }
.s-draft     { background: #fff7e8; color: #d25f00; }
.s-deferred  { background: #e8f0ff; color: #165dff; }
.s-signed    { background: #e8f3ff; color: #165dff; }
.s-waiting   { background: #fff7e8; color: #d25f00; }
.s-done      { background: #e8ffea; color: #00b42a; }
.s-abandoned { background: #fff2f0; color: #f53f3f; }
.s-gray      { background: #f2f3f5; color: #86909c; }

/* ========== 空状态 / 权限 ========== */
.empty {
  text-align: center; padding: 64px 20px; color: var(--text-3); font-size: 13.5px;
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
}
.empty h3 { font-size: 14px; color: var(--text-2); margin-bottom: 6px; font-weight: 500; }
.no-perm-box {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 72px 24px; text-align: center;
}
.no-perm-box h3 { font-size: 16px; color: var(--text); margin-bottom: 10px; font-weight: 600; }
.no-perm-box p { font-size: 13px; color: var(--text-3); line-height: 1.8; }

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed; inset: 0; background: rgba(29,33,41,.4); z-index: 300;
  display: grid; place-items: center; padding: 20px; animation: fadeIn .18s;
}
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
.modal-sm {
  background: var(--surface); border-radius: 8px;
  padding: 22px; width: 420px; max-width: 94vw;
  box-shadow: 0 10px 40px rgba(0,0,0,.15); animation: pop .18s;
}
@keyframes pop { from{transform:scale(.96);opacity:.6} to{transform:scale(1);opacity:1} }
.modal-sm h3 { font-size: 15px; color: var(--text); margin-bottom: 10px; font-weight: 600; }
.modal-sm p { font-size: 13px; color: var(--text-2); line-height: 1.75; margin-bottom: 18px; }
.modal-sm b { color: var(--text); }
.modal-btns { display: flex; justify-content: flex-end; gap: 10px; }
.tpl-edit-modal { width: 700px; max-width: 94vw; }
.tpl-edit-modal .field { margin-bottom: 16px; }
