          <div class="info-row"><span class="k">合同编号</span><span class="v">${escHtml(c.no)}</span></div>
          <div class="info-row"><span class="k">甲方主体</span><span class="v">${escHtml(c.partyAName)}</span></div>
          <div class="info-row"><span class="k">乙方主体</span><span class="v">${escHtml(c.partyB)}</span></div>
