      leftContent = `<div class="empty" style="padding:80px 20px;"><h3>⏳ 正在解析文档…</h3><p>正在提取全文并与原模板比对，请稍候（首次需加载在线解析组件）</p></div>`;
    } else if (/\.pdf$/i.test(state.form.nsFileName || '')) {
      leftContent = `<div class="pdf-preview-wrap"><iframe class="pdf-iframe" src="${state.form.nsFileUrl}#toolbar=0&navpanes=0"></iframe></div>`;
    } else {
      leftContent = `<div class="doc" style="padding:24px;">
        <div class="h" style="font-size:16px;margin-bottom:12px;">文档提取全文（真实解析）</div>
        <div style="background:var(--surface-2);padding:16px;border-radius:6px;font-size:13px;line-height:1.8;white-space:pre-wrap;max-height:600px;overflow-y:auto;">${escHtml(state.form.nsParsedText || '正在解析...')}</div>
      </div>`;
    }
  } else if (step === 3) {
    leftContent = `<div class="doc" style="padding:24px;">
      <div class="h" style="font-size:16px;margin-bottom:12px;">与原模板修订对比</div>
      ${state.form.nsDiffs ? state.form.nsDiffs.map(d => `
        <div class="diff-block" style="margin-bottom:12px;">
          <div class="diff-title">${escHtml(d.field)}</div>
          <div style="display:flex;gap:16px;">
            <div style="flex:1;background:#fff2f0;padding:8px;border-radius:4px;">
              <span style="color:#f53f3f;font-size:12px;">原模板：</span><br><del>${escHtml(d.original)}</del>
            </div>
            <div style="flex:1;background:#e8ffea;padding:8px;border-radius:4px;">
              <span style="color:#00b42a;font-size:12px;">业务文档：</span><br><ins>${escHtml(d.revised)}</ins>
            </div>
          </div>
        </div>
      `).join('') : '<div class="empty"><h3>暂无对比数据</h3></div>'}
    </div>`;
  }

  let rightHtml = '';
  if (step === 1) {
    rightHtml = `
      <div class="panel">
        <div class="panel-title">第一步：选择原模板</div>
        <label class="field">
          <span class="field-label">选择一份法务模板作为对比基准</span>
          <select data-key="originTplCode" id="originTplSelect">
            <option value="">请选择原模板</option>
            ${state.tpls.map(t => `<option value="${t.code}" ${state.form.originTplCode === t.code ? 'selected' : ''}>${t.code} · ${t.name}</option>`).join('')}
          </select>
        </label>
      </div>
      <div class="fill-footer" style="border:none; margin-top:0;">
        <button class="btn btn-primary" data-act="ns-next" ${!state.form.originTplCode ? 'disabled' : ''}>下一步：上传文档</button>
      </div>`;
  } else if (step === 2) {
    rightHtml = `
      <div class="panel">
        <div class="panel-title">第二步：上传业务文档</div>
        <button type="button" id="uploadWordBtn" class="btn btn-primary" data-act="upload-word" style="width:100%;">
          ${state.form.nsFileUrl ? '重新上传' : '上传 Word / PDF'}
        </button>
        <input type="file" id="wordUploadInput" accept=".doc,.docx,.pdf" style="display:none">
        <div class="file-info-box ${state.form.nsFileUrl ? '' : 'empty'}">
          ${state.form.nsFileUrl ? `已上传：<b>${escHtml(state.form.nsFileName)}</b>` : '尚未上传文档'}
        </div>
      </div>
      <div class="fill-footer" style="border:none; margin-top:0;">
        <button class="btn" data-act="ns-prev">上一步</button>
        <button class="btn btn-primary" data-act="ns-next" ${!state.form.nsFileUrl ? 'disabled' : ''}>下一步：查看对比</button>
      </div>`;
  } else if (step === 3) {
    rightHtml = `
      <div class="panel">
        <div class="panel-title">第三步：确认并提交</div>
        
        <div class="auto-card">
          <div class="auto-card-head">
            <div class="auto-card-title">✨ 系统自动识别（来自文档真实解析，可修正）</div>
            <span class="auto-badge">自动提取</span>
          </div>
          <label class="field"><span class="field-label">甲方主体</span><input type="text" data-key="nsParsedPartyA" value="${escHtml(state.form.nsParsedPartyA || '')}" placeholder="未识别到，请手动填写"></label>
          <label class="field"><span class="field-label">乙方主体</span><input type="text" data-key="nsParsedPartyB" value="${escHtml(state.form.nsParsedPartyB || '')}" placeholder="未识别到，请手动填写"></label>
          <label class="field"><span class="field-label">乙方联系人</span><input type="text" data-key="nsParsedContact" value="${escHtml(state.form.nsParsedContact || '')}" placeholder="未识别到，请手动填写"></label>
          <label class="field"><span class="field-label">联系电话</span><input type="tel" maxlength="11" data-key="nsParsedPhone" value="${escHtml(state.form.nsParsedPhone || '')}" placeholder="未识别到，请手动填写"></label>
        </div>

        <label class="field"><span class="field-label">合同名称<i>*</i></span><input type="text" data-key="nsName" value="${escHtml(state.form.nsName || '')}" placeholder="请输入合同名称"></label>
        <label class="field"><span class="field-label">合同类型<i>*</i></span>
          <select data-key="contractType"><option value="">请选择类型</option>
          ${CONTRACT_TYPES.map(t => `<option value="${t}" ${state.form.contractType === t ? 'selected' : ''}>${t}</option>`).join('')}
          </select>
        </label>
      </div>
      <div class="fill-footer" style="border:none; margin-top:0;">
        <button class="btn" data-act="ns-prev">上一步</button>
        <button class="btn btn-primary" data-act="submit-nonstandard">提交法务审批</button>
      </div>`;
  }

  return `<div class="page-head">
    <h1>非标准化协议提交</h1>
    <p>分三步走：选择原模板 → 上传文档识别 → 比对并提交</p>
  </div>
  
  <div class="step-indicator">
    <div class="step-item ${step === 1 ? 'active' : (step > 1 ? 'done' : '')}">
      <div class="step-num">${step > 1 ? '✓' : '1'}</div>
      选择原模板
    </div>
    <div class="step-line"></div>
    <div class="step-item ${step === 2 ? 'active' : (step > 2 ? 'done' : '')}">
      <div class="step-num">${step > 2 ? '✓' : '2'}</div>
      上传文档识别
    </div>
    <div class="step-line"></div>
    <div class="step-item ${step === 3 ? 'active' : ''}">
      <div class="step-num">3</div>
      比对与提交
    </div>
  </div>

  <div class="fill-layout">
    <div class="fill-left">
      ${leftContent}
    </div>
    <div class="fill-right">
      <div class="fill-panels">
        ${rightHtml}
      </div>
      <div class="fill-footer" style="border:none; margin-top:0;">
        ${step === 1 ? `<button class="btn" data-act="back-templates">← 回退</button>` : ''}
      </div>
    </div>
  </div>`;
}

/* =======================================================
   视图渲染：签约管理
   ======================================================= */
function viewManage() {
  const all = visibleContracts();
  const roleTip = state.role === 'legal' ? '法务视角 · 可查看全部业务提交的合同' : `业务视角 · 仅显示 ${currentUser().name} 发起的合同`;

  if (!all.length) {
    return `<div class="page-head"><h1>签约管理</h1><p>${escHtml(roleTip)}</p></div>
    <div class="empty"><h3>暂无合同</h3><p>请先前往「提起签约」创建合同</p></div>`;
  }

  return `<div class="page-head"><h1>签约管理</h1><p>${escHtml(roleTip)} · 共 ${all.length} 份合同</p></div>
  <div class="filter-bar">
    <div class="filter-item">
      <label>我方主体</label>
      <select data-filter="partyA"><option value="">全部</option>
        ${PARTY_A_LIST.map(p => `<option value="${p.id}" ${state.filters.partyA === p.id ? 'selected' : ''}>${escHtml(p.short)}</option>`).join('')}
      </select>
    </div>
    <div class="filter-item">
      <label>对方主体</label>
      <input type="text" data-filter="partyB" placeholder="输入对方主体名称" value="${escHtml(state.filters.partyB)}">
    </div>
    <div class="filter-item">
      <label>签约日期</label>
      <select data-filter="dateRange">
        ${DATE_FILTER_OPTIONS.map(o => `<option value="${o.value}" ${state.filters.dateRange === o.value ? 'selected' : ''}>${o.label}</option>`).join('')}
      </select>
    </div>
    <div class="filter-item">
      <label>签约进度</label>
      <select data-filter="status">
        <option value="all">全部进度</option>
        <option value="legal_review" ${state.filters.status === 'legal_review' ? 'selected' : ''}>法务审批中</option>
        <option value="legal_returned" ${state.filters.status === 'legal_returned' ? 'selected' : ''}>法务退回</option>
        <option value="draft" ${state.filters.status === 'draft' ? 'selected' : ''}>待签章</option>
        <option value="deferred" ${state.filters.status === 'deferred' ? 'selected' : ''}>稍后签章</option>
        <option value="signed_a" ${state.filters.status === 'signed_a' ? 'selected' : ''}>已签章</option>
        <option value="pending_b" ${state.filters.status === 'pending_b' ? 'selected' : ''}>对方未完成</option>
        <option value="completed" ${state.filters.status === 'completed' ? 'selected' : ''}>签署完成</option>
      </select>
    </div>
    <button class="btn btn-sm" data-act="reset-filters" style="margin-left:auto;">重置筛选</button>
  </div>
  <div class="table-wrap">
    <table class="tbl">
      <thead>
        <tr>
          <th>合同编号</th><th>名称</th><th>模板编号</th><th>合同类型</th><th>提交人</th><th>我方主体</th><th>对方主体</th><th>联系人</th><th>手机号</th><th>进度</th><th style="min-width:200px">操作</th>
        </tr>
      </thead>
      <tbody id="manageTbody">
        ${getFilteredContracts().map(c => renderContractRow(c)).join('') ||
          '<tr><td colspan="11" style="text-align:center;color:var(--text-3);padding:40px 0;">暂无符合条件的合同</td></tr>'}
      </tbody>
    </table>
  </div>`;
}

function renderContractRow(c) {
  const st = STATUS_MAP[c.status];
  return `<tr>
    <td><div class="cno">${escHtml(c.no)}</div></td>
    <td><div class="strong">${escHtml(c.tplName)}</div><div class="sub">${c.isUpload ? '非标上传' : '标准化协议'}</div></td>
    <td><span class="tcode">${escHtml(c.tplCode || c.originTplCode || '—')}</span></td>
    <td>${escHtml(c.contractType || '—')}</td>
    <td><div class="strong">${escHtml(c.createdBy || '—')}</div></td>
    <td><div class="strong">${escHtml(c.partyAName)}</div></td>
    <td><div class="strong">${escHtml(c.partyB)}</div></td>
    <td>${escHtml(c.contact || '—')}</td>
    <td>${escHtml(c.phone || '—')}</td>
    <td><span class="s ${st.cls}">${st.text}</span></td>
    <td>${opButtons(c)}</td>
  </tr>`;
}

function opButtons(c) {
  const id = c.id;
  const isLegal = state.role === 'legal';

  switch (c.status) {
    case 'legal_review':
      if (isLegal) {
        return `<div class="op-cell">
          <button class="btn btn-sm btn-primary" data-act="view-approval" data-id="${id}">去审批</button>
          <button class="btn btn-sm btn-danger" data-act="delete-c" data-id="${id}">删除</button>
        </div>`;
      }
      return `<div class="op-cell"><span style="font-size:12px;color:var(--text-3);">等待法务审批</span></div>`;

    case 'legal_returned':
      if (isLegal) {
        return `<div class="op-cell">
          <button class="btn btn-sm" data-act="view-return-history" data-id="${id}">退回记录</button>
          <span style="font-size:12px;color:var(--danger);">已退回${c.returnCount ? `（第 ${c.returnCount} 轮）` : ''}，等待业务重提</span>
        </div>`;
      }
      return `<div class="op-cell">
        <button class="btn btn-sm btn-primary" data-act="resubmit-c" data-id="${id}">重新提交</button>
        <button class="btn btn-sm btn-danger" data-act="view-return-history" data-id="${id}">退回意见${c.returnCount ? `（${c.returnCount}）` : ''}</button>
      </div>`;

    case 'draft':
      return `<div class="op-cell">
        <button class="btn btn-sm btn-primary" data-act="open-fadada" data-id="${id}">去签章</button>
        <button class="btn btn-sm" data-act="return-c" data-id="${id}">退回</button>
        <button class="btn btn-sm btn-danger" data-act="delete-c" data-id="${id}">删除</button>
      </div>`;

    case 'deferred':
      return `<div class="op-cell">
        <button class="btn btn-sm btn-primary" data-act="open-fadada" data-id="${id}">去签章</button>
        <button class="btn btn-sm" data-act="return-c" data-id="${id}">退回</button>
        <button class="btn btn-sm btn-danger" data-act="delete-c" data-id="${id}">删除</button>
      </div>`;

    case 'signed_a':
      return `<div class="op-cell">
        <button class="btn btn-sm btn-primary" data-act="send-link" data-id="${id}">发送签约链接</button>
        <button class="btn btn-sm btn-danger" data-act="delete-c" data-id="${id}">删除</button>
      </div>`;

    case 'pending_b':
      return `<div class="op-cell">
        <button class="btn btn-sm" data-act="start-sign" data-id="${id}">查看进度</button>
        <button class="btn btn-sm" data-act="abandon-c" data-id="${id}">放弃签署</button>
        <button class="btn btn-sm btn-danger" data-act="delete-c" data-id="${id}">删除</button>
      </div>`;

    case 'completed':
      return `<div class="op-cell">
        <button class="btn btn-sm" data-act="view-c" data-id="${id}">查看合同</button>
      </div>`;

    case 'abandoned':
    case 'returned':
      return `<div class="op-cell">
        <button class="btn btn-sm btn-primary" data-act="reopen" data-id="${id}">重新发起</button>
        <button class="btn btn-sm btn-danger" data-act="delete-c" data-id="${id}">删除</button>
      </div>`;

    default:
      return '';
  }
}

/* =======================================================
   视图渲染：发起签约
