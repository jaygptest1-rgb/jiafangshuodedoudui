function bindDropZone(zoneId, inputId, onFile) {
  const zone = document.getElementById(zoneId), input = document.getElementById(inputId);
  if (!zone || !input || zone.dataset.dropBound) return;
  zone.dataset.dropBound = '1';
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
  zone.addEventListener('dragleave', e => { e.preventDefault(); zone.classList.remove('dragover'); });
  zone.addEventListener('drop', e => {
    e.preventDefault(); zone.classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file) onFile(file);
  });
  zone.addEventListener('click', () => input.click());
}

/* ============ 文档真实解析（docx / pdf 全文提取） ============ */
function loadScript(src) {
  return new Promise((resolve, reject) => {
    if ([...document.scripts].some(s => s.src === src)) return resolve();
    const s = document.createElement('script');
    s.src = src; s.onload = resolve; s.onerror = () => reject(new Error('加载失败: ' + src));
    document.head.appendChild(s);
  });
}

async function extractDocxText(file) {
  await loadScript('https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js');
  const buf = await file.arrayBuffer();
  const result = await window.mammoth.extractRawText({ arrayBuffer: buf });
  return result.value || '';
}

async function extractPdfText(file) {
  await loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js');
  window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  const buf = await file.arrayBuffer();
  const pdf = await window.pdfjsLib.getDocument({ data: buf }).promise;
  let out = '';
  for (let i = 1; i <= pdf.numPages; i++) {
    const page = await pdf.getPage(i);
    const content = await page.getTextContent();
    out += content.items.map(it => it.str).join(' ') + '\n';
  }
  return out;
}

/* 从真实文档全文中提取甲乙方信息 */
function extractPartiesFromText(text) {
  const t = toSimplified(fullToHalf(text)).replace(/\r/g, '');
  const lines = t.split(/\n+/).map(l => l.trim()).filter(Boolean);
  const res = { partyA: '', partyB: '', contact: '', phone: '' };

  const cleaned = t.replace(/[-\s]/g, '');
  const mob = cleaned.match(/(?:\+?86)?1[3-9]\d{9}/);
  const tel = cleaned.match(/0\d{2,3}\d{7,8}/);
  if (mob) res.phone = mob[0].replace(/^\+?86/, '');
  else if (tel) res.phone = tel[0];

  const companyLike = /(公司|集团|有限|股份|商行|事务所|研究院|ltd|limited|inc|corp|llc|company|co\.)/i;
  for (const line of lines) {
    const ll = line.toLowerCase();
    if (!res.partyA) {
      const m = line.match(/^(甲方|发包方|采购方|委托方|需方|购方)\s*[:：]?\s*(.+)$/);
      if (m && companyLike.test(m[2])) res.partyA = m[2].trim();
      else if (!res.partyB && m) res.partyA = m[2].trim();
    }
    if (!res.partyB) {
      const m = line.match(/^(乙方|承包方|供货方|供应方|服务方|受托方|卖方|供方)\s*[:：]?\s*(.+)$/);
      if (m && (companyLike.test(m[2]) || m[2].length > 3)) res.partyB = m[2].trim();
    }
    if (!res.contact) {
      const m = line.match(/^(联系人|联络人|contact( person| name)?|attn)\s*[:：]\s*(.+)$/i);
      if (m) res.contact = m[3].replace(/(电话|phone|tel|手机|mobile|邮箱|email)\s*[:：]?\S*$/i, '').trim();
    }
  }
  // 兜底：正文里直接出现的公司名（第一处甲方附近 / 英文识别）
  if (!res.partyA || !res.partyB) {
    const names = lines.filter(l => companyLike.test(l) && !/^(甲方|乙方)/.test(l) && !/(地址|address|电话|phone|tel)/i.test(l));
    if (!res.partyA && names.length) res.partyA = names[0].replace(/^本司[，,]?/, '').trim();
    if (!res.partyB && names.length > 1) res.partyB = names[1].trim();
  }
  if (!res.contact) {
    const m = t.match(/([\u4e00-\u9fa5]{1,3}(?:先生|女士|小姐))/);
    if (m) res.contact = m[1];
  }
  return res;
}

/* 与原模板做真实差异对比（LCS 逐段比对） */
function normPara(s) {
  return toSimplified(fullToHalf(String(s || '')))
    .replace(/\*\*/g, '').replace(/^[#\s]+/, '').replace(/\s+/g, ' ').trim();
}
function diffAgainstTpl(originBody, newText) {
  const A = String(originBody || '').split('\n').map(normPara).filter(l => l && !l.startsWith('（以下'));
  const B = String(newText || '').split('\n').map(normPara).filter(Boolean);
  const n = A.length, m = B.length;
  // LCS 动态规划（限制规模防止卡顿）
  if (n * m > 4000000) return [{ field: '文档过长', original: '原文档段落数：' + n, revised: '上传文档段落数：' + m }];
  const dp = Array.from({ length: n + 1 }, () => new Uint16Array(m + 1));
  for (let i = n - 1; i >= 0; i--)
    for (let j = m - 1; j >= 0; j--)
      dp[i][j] = A[i] === B[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
  const diffs = [];
  let i = 0, j = 0;
  while (i < n && j < m) {
    if (A[i] === B[j]) { i++; j++; continue; }
    const dels = [], adds = [];
    while (i < n && (j >= m || dp[i + 1][j] >= dp[i][j + 1]) && A[i] !== B[j]) { dels.push(A[i]); i++; if (dels.length > 15) break; }
    while (j < m && (i >= n || dp[i][j + 1] > dp[i + 1][j]) && (i >= n || A[i] !== B[j])) { adds.push(B[j]); j++; if (adds.length > 15) break; }
    if (dels.length || adds.length) diffs.push({
      field: dels.length && adds.length ? '条款修改' : (dels.length ? '条款删除' : '条款新增'),
      original: dels.join(' / ') || '（无）',
      revised: adds.join(' / ') || '（已删除）'
    });
  }
  while (i < n) { diffs.push({ field: '条款删除', original: A[i], revised: '（上传文档中已无此段）' }); i++; }
  while (j < m) { diffs.push({ field: '条款新增', original: '（原模板中无此段）', revised: B[j] }); j++; }
  return diffs.slice(0, 20);
}

function handleWordUpload(file) {
  if (!file.name.match(/\.(doc|docx|pdf)$/i)) return toast('请上传 Word 或 PDF 格式文件');
  if (state.form.nsFileUrl) URL.revokeObjectURL(state.form.nsFileUrl);

  state.form.nsFileUrl = URL.createObjectURL(file);
  state.form.nsFileName = file.name;
  state.form.nsParsing = true;
  state.form.nsParsedText = '正在解析文档，请稍候…';
  render();

  const finish = (text) => {
    const parsed = extractPartiesFromText(text);
    state.form.nsParsedText = text || '（未能提取到文本内容）';
    state.form.nsParsedPartyA = parsed.partyA || state.form.nsParsedPartyA || '';
    state.form.nsParsedPartyB = parsed.partyB || state.form.nsParsedPartyB || '';
    state.form.nsParsedContact = parsed.contact || state.form.nsParsedContact || '';
    state.form.nsParsedPhone = parsed.phone || state.form.nsParsedPhone || '';

    // 与所选原模板做真实差异比对
    const tpl = state.tpls.find(t => t.code === state.form.originTplCode);
    if (tpl) {
      state.form.nsDiffs = diffAgainstTpl(tpl.body, text);
    }

    if (!state.form.nsName) {
      state.form.nsName = (parsed.partyB || state.form.nsFileName.replace(/\.(docx?|pdf)$/i, '')) + '-修订合同';
    }
    state.form.nsParsing = false;
    render();
    if (!parsed.partyB || !parsed.phone) toast('解析完成：部分信息未识别到，可在下一步手动补充');
    else toast('文档解析成功，已提取双方信息并与原模板比对');
  };

  const run = async () => {
    try {
      const text = /\.pdf$/i.test(file.name) ? await extractPdfText(file) : await extractDocxText(file);
      finish(text);
    } catch (e) {
      state.form.nsParsing = false;
      state.form.nsParsedText = '⚠ 在线解析组件加载失败（需联网），已回退为演示数据。\n\n' + (state.form.nsParsedText || '');
      finish('');
      toast('解析组件加载失败，已使用演示数据');
    }
  };
  run();
}

/* =======================================================
   渲染入口与事件委托
   ======================================================= */
function render() {
  renderSidebar();
  mainEl.className = 'main' + (['fill', 'nonstandard', 'signA', 'approvalDetail'].includes(state.view) ? ' flex-main' : '');

  switch (state.view) {
    case 'templates': mainEl.innerHTML = viewTemplates(); break;
    case 'tplPick': mainEl.innerHTML = viewTplPick(); break;
    case 'fill': mainEl.innerHTML = viewFill(); break;
    case 'nonstandard': mainEl.innerHTML = viewNonstandard(); break;
    case 'manage': mainEl.innerHTML = viewManage(); break;
    case 'signA': mainEl.innerHTML = viewSignA(); break;
    case 'contracts': mainEl.innerHTML = viewContracts(); break;
    case 'tplAdmin': mainEl.innerHTML = viewTplAdmin(); break;
    case 'approval': mainEl.innerHTML = viewApprovalList(); break;
    case 'approvalDetail': mainEl.innerHTML = viewApprovalDetail(); break;
    case 'noPerm': mainEl.innerHTML = viewNoPerm(); break;
    case 'noPermContracts': mainEl.innerHTML = viewNoPermContracts(); break;
    default: mainEl.innerHTML = viewTemplates();
  }
  mainEl.scrollTop = 0;

  if (state.view === 'nonstandard' && state.nsStep === 2) {
    bindDropZone('nsDropZone', 'wordUploadInput', handleWordUpload);
    // 直接绑定上传按钮与文件选择，确保点击必定触发（修复“上传文档无法点击”问题）
    const upBtn = document.getElementById('uploadWordBtn');
    const upInput = document.getElementById('wordUploadInput');
    if (upBtn && upInput) {
      upBtn.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); upInput.click(); });
      upInput.addEventListener('change', e => { const f = e.target.files[0]; if (f) handleWordUpload(f); });
    }
  }
}

document.addEventListener('click', e => {
  const el = e.target.closest('[data-act]');
  if (!el) return;
  const act = el.dataset.act;
  const id = el.dataset.id;

  switch (act) {
    case 'set-role':
      state.role = el.dataset.role;
      if(state.role === 'biz' && ['approval','approvalDetail','tplAdmin','contracts','noPermContracts'].includes(state.view)) state.view = 'templates';
      render();
      // 切换视角时提示对方侧数据已实时同步
      if (state.role === 'legal') {
        const n = state.contracts.filter(c => c.status === 'legal_review').length;
        toast(n ? `已切换至法务视角 · 业务侧最新提交已同步，${n} 份待审批` : '已切换至法务视角 · 业务侧数据已实时同步');
      } else {
        const r = state.contracts.filter(c => c.status === 'legal_returned' && c.createdBy === currentUser().name).length;
        const d = state.contracts.filter(c => c.status === 'draft' && c.createdBy === currentUser().name).length;
        toast(`已切换至业务视角 · 法务侧最新审批结果已同步${r ? `（${r} 份被退回待处理）` : d ? `（${d} 份审批通过待签章）` : ''}`);
      }
      break;
    case 'toggle-apply': state.applyOpen = !state.applyOpen; renderSidebar(); break;
    case 'download-page': downloadPage(); break;
    case 'go': state.view = el.dataset.view; if(state.view==='templates'){state.selectedTplId=null;state.form={};} render(); break;
    case 'choose-standard': chooseStandard(); break;
    case 'choose-nonstandard':
      if (state.form.nsFileUrl) URL.revokeObjectURL(state.form.nsFileUrl);
      state.view = 'nonstandard'; state.form = {}; state.nsStep = 1; render();
      break;
    case 'ns-next':
      if (state.nsStep === 1 && !state.form.originTplCode) return toast('请先选择原模板');
      if (state.nsStep === 2 && !state.form.nsFileUrl) return toast('请先上传文档');
      state.nsStep++; render();
      break;
    case 'ns-prev':
      state.nsStep--; render();
      break;
    case 'upload-word': document.getElementById('wordUploadInput').click(); break;
    case 'submit-nonstandard': submitNonstandard(); break;
    case 'use-tpl': useTemplate(id); break;
    case 'back-templates': backToTemplates(); break;
    case 'back-pick': backToPick(); break;
    case 'generate': generateContract(); break;
    case 'open-fadada': openFadada(id); break;
    case 'fadada-seal': fadadaSeal(id); break;
    case 'fadada-defer': fadadaDefer(); break;
    case 'fadada-back': fadadaBack(); break;
    case 'audit-pass': auditPass(id); break;
    case 'start-sign': startSign(id); break;
    case 'send-link': sendLink(id); break;
    case 'return-c': returnContract(id); break;
    case 'abandon-c': abandonContract(id); break;
    case 'delete-c': deleteContract(id); break;
    case 'reopen': reopenContract(id); break;
    case 'view-c': viewContract(id); break;
    case 'download-c': toast('合同文件下载中...'); break;
    case 'download-upload': toast('业务文档下载中...'); break;
    case 'simulate-b': openBSign(id); break;
    case 'b-sign': bSign(id); break;
    case 'b-abandon': bAbandon(id); break;
    case 'view-approval': state.currentApprovalId = id; state.approvalTab = 'origin'; state.view = 'approvalDetail'; render(); break;
    case 'switch-approval-tab': state.approvalTab = el.dataset.tab; render(); break;
    case 'pass-approval':
      const c1 = state.contracts.find(x => x.id === id); if(c1) c1.status = 'draft';
      state.view = 'approval'; render(); toast('审批通过');
      break;
    case 'reject-approval':
      rejectApprovalModal(id);
      break;
    case 'view-return-history':
      viewReturnHistoryModal(id);
      break;
    case 'resubmit-c':
      resubmitModal(id);
      break;
    case 'partyB-smart':
      smartFillPartyB();
      break;
    case 'partyB-paste-parse':
      applyPartyBBlock();
      break;
    case 'tpl-new': openTplEditor(null); break;
    case 'tpl-upload': document.getElementById('tplUploadInput').click(); break;
    case 'tpl-edit': { const t = state.tpls.find(x => x.id === id); if(t) openTplEditor(t); break; }
    case 'tpl-del':
      const t = state.tpls.find(x => x.id === id);
      if (!t) return;
      showConfirm('删除模板', `确定删除 <b>${escHtml(t.name)}</b> 吗？`, '确定删除', () => {
        state.tpls = state.tpls.filter(x => x.id !== id); render(); toast('模板已删除');
      });
      break;
    case 'reset-filters': state.filters = { partyA: '', partyB: '', dateRange: 'all', status: 'all' }; render(); break;
    case 'reset-sfilters': state.summaryFilters = { partyA: '', partyB: '', dateRange: 'all', contractType: 'all' }; render(); break;
    case 'reset':
      showConfirm('重置数据', '确定重置？', '重置', () => {
        state.contracts = buildSeedContracts();
        state.tpls = JSON.parse(JSON.stringify(DEFAULT_TPLS));
        state.form = {}; state.view = 'templates'; state.nsStep = 1; render(); toast('已重置');
      });
      break;
  }
});

document.addEventListener('change', e => {
  if (e.target.id === 'tplUploadInput') {
    const file = e.target.files[0]; if (!file) return;
    const name = file.name.replace(/\.(docx?|pdf)$/i, '');
    state.tpls.push({
      id: 't' + Date.now(), code: nextTplCode(), name, contractType: '采购协议',
      fileName: file.name, body: `## ${name}\n占位内容`, updatedAt: today(), fields: []
    });
    e.target.value = ''; render(); toast('模板已上传');
    return;
  }
  if (e.target.id === 'wordUploadInput') {
    const file = e.target.files[0]; if (file) handleWordUpload(file);
  }
  if (e.target.id === 'originTplSelect') {
    state.form.originTplCode = e.target.value; render();
  }
  if (e.target.dataset.key === 'partyAId' && state.view === 'fill') {
    const pa = PARTY_A_LIST.find(p => p.id === e.target.value);
    if (pa) { state.form.partyAAddress = pa.address; const el = document.querySelector('[data-key="partyAAddress"]'); if (el) el.value = pa.address; }
  }
  const sf = e.target.closest('[data-sfilter]');
  if (sf) { state.summaryFilters[sf.dataset.sfilter] = sf.value; render(); }
  const f = e.target.closest('[data-filter]');
  if (f && f.dataset.filter !== 'partyB') { state.filters[f.dataset.filter] = f.value; render(); }
});

document.addEventListener('input', e => {
  const el = e.target.closest('[data-key]');
  if (el) {
    if (state.view === 'fill') {
      state.form[el.dataset.key] = el.value;
      const preview = document.getElementById('docPreview');
      if (preview) preview.innerHTML = renderDoc(draftContract(), true);
      return;
    }
    if (state.view === 'nonstandard') { state.form[el.dataset.key] = el.value; return; }
  }
  const fEl = e.target.closest('[data-filter="partyB"]');
  if (fEl) { state.filters.partyB = fEl.value; updateManageTable(); }
});

function updateManageTable() {
  const tbody = document.getElementById('manageTbody');
  if (!tbody) return;
  const list = getFilteredContracts();
  tbody.innerHTML = list.length ? list.map(c => renderContractRow(c)).join('') : '<tr><td colspan="11" style="text-align:center;color:var(--text-3);padding:40px 0;">暂无数据</td></tr>';
}

// 乙方公司名称回车触发智能识别；粘贴框回车触发整段识别
document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.target && e.target.id === 'partyBInput') {
    e.preventDefault();
    smartFillPartyB();
  }
  if (e.key === 'Enter' && e.target && e.target.id === 'partyBPasteBox') {
    e.preventDefault();
    applyPartyBBlock();
  }
});

// 启动
render();
</script>

